    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Edad" type="Integer" array="False" size=""/>
            <output expression="&quot;CUAL ES TU EDAD?&quot;" newline="True"/>
            <input variable="Edad"/>
            <if expression="Edad &gt;= 18">
                <then>
                    <output expression="&quot;Ya te la rifaste broder, si puedes entrar bisonteamigo&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Pues no puedes entrar bisonteamigo, tendras que esperar hasta ser mayor de edad jejeje&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
